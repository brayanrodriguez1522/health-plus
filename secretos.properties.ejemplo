#APUNTES DE IA PARA ENLAZAR CUENTAS REALES

# ================================================================
#  HEALTH+  -  secretos.properties   (NO subir a GitHub)
#  1) Copiar archivo y renombrarlo a:  secretos.properties
#  2) Llenar SOLO lo que vaya a usar. Lo que deje comentado (#) queda apagado.
# ================================================================

# Correo real (Gmail) para enviar el código de registro ----------
# La contraseña no es la del gmail: es una "contraseña de aplicación" de 16 letras
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
#spring.mail.host=smtp.gmail.com ---> La dirección del "servidor de correo saliente" de Gmail, la "oficina de correos" que entrega el mensaje.
#spring.mail.port=587 ---> La "puerta" por donde se conecta a esa oficina. Gmail usa la 587.
#spring.mail.username=tucorreo@gmail.com ---> El gmail remitente por el que le va llegar el correo a las personas
#spring.mail.password=abcd efgh ijkl mnop ---> contraseña de 16 letras de google
#spring.mail.properties.mail.smtp.auth=true ---> Quiere decir que para iniciar sesion se necesita un usuario con contraseña
#spring.mail.properties.mail.smtp.starttls.enable=true ---> es como un cifrado para que nadie pueda leer la conexion del correo, gmail lo exije

# Iniciar sesión con Google ----------
# console.cloud.google.com > APIs y servicios > Credenciales > ID de cliente OAuth (Aplicación web)
# URI de redireccionamiento autorizado:  http://localhost:8080/login/oauth2/code/google
#spring.security.oauth2.client.registration.google.client-id=TU_CLIENT_ID.apps.googleusercontent.com
#spring.security.oauth2.client.registration.google.client-secret=TU_CLIENT_SECRET
#spring.security.oauth2.client.registration.google.scope=openid,profile,email

# Iniciar sesión con Facebook ----------
# developers.facebook.com > Mis apps > Crear app > Inicio de sesión con Facebook
# URI de redireccionamiento OAuth válido:  http://localhost:8080/login/oauth2/code/facebook
#spring.security.oauth2.client.registration.facebook.client-id=TU_APP_ID
#spring.security.oauth2.client.registration.facebook.client-secret=TU_APP_SECRET
#spring.security.oauth2.client.registration.facebook.scope=email,public_profile
